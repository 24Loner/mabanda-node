{
  "name": "mabanda-node-postgres",
  "version": "1.0.0",
  "private": true,
  "description": "Faithful Node.js + PostgreSQL migration of the Mabanda PHP/MySQL school management system.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node database/apply-schema.js",
    "db:seed": "node database/seed.js",
    "db:setup": "npm run db:schema && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.13.1",
    "puppeteer": "^25.12.0",
    "serverless-http": "^4.0.0"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
